{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "invoicer",
	"version": "1.0.5",
	"identifier": "com.finn.invoicer",
	"build": {
		"frontendDist": "../src"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "invoicer",
				"width": 1280,
				"height": 720,
				"minWidth": 420,
				"transparent": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
