{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "invoicer",
	"version": "0.1.0",
	"identifier": "Invoicer",
	"build": {
		"frontendDist": "../src"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "invoicer",
				"width": 800,
				"height": 600,
				"minWidth": 420
			}
		],
		"security": {
			"csp": null,
			"capabilities": [
				{
					"identifier": "fs-capability",
					"description": "File system capability in application",
					"windows": ["*"],
					"permissions": [
						"fs:default",
						{
							"identifier": "fs:allow-open",
							"allow": [{ "path": "$APPDATA/*" }]
						},
						{
							"identifier": "fs:allow-read",
							"allow": [{ "path": "$APPDATA/*" }]
						},
						{
							"identifier": "fs:allow-write",
							"allow": [{ "path": "$APPDATA/*" }]
						},
						{
							"identifier": "fs:allow-exists",
							"allow": [{ "path": "$APPDATA/*" }]
						},
						{
							"identifier": "fs:allow-create",
							"allow": [{ "path": "$APPDATA/*" }]
						}
					]
				},
				{
					"identifier": "close-capability",
					"description": "Close capability in application",
					"windows": ["*"],
					"permissions": [
						"core:resources:default",
						{
							"identifier": "core:resources:allow-close",
							"allow": [{ "path": "$APPDATA/*" }]
						}
					]
				}
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
