{
  	"$schema": "../gen/schemas/desktop-schema.json",
  	"identifier": "default",
  	"description": "Capability for the main window",
  	"windows": [
    	"main"
  	],
  	"permissions": [
		"core:default",
		"core:resources:default",
		"opener:default",
		"fs:default",
		"sql:default",
		"sql:allow-execute",
		{
			"identifier": "core:resources:allow-close",
			"allow": [{ "path": "$APPDATA/*" }]
		},
		{
			"identifier": "fs:allow-open",
			"allow": [{ "path": "$APPDATA/*" }]
		},
		{
			"identifier": "fs:allow-read",
			"allow": [{ "path": "$APPDATA/*" }]
		},
		{
			"identifier": "fs:allow-write",
			"allow": [{ "path": "$APPDATA/*" }]
		},
		{
			"identifier": "fs:allow-exists",
			"allow": [{ "path": "$APPDATA/*" }]
		},
		{
			"identifier": "fs:allow-create",
			"allow": [{ "path": "$APPDATA/*" }]
		},
		{
			"identifier": "sql:allow-load",
			"allow": [{ "path": "$APPDATA/*" }]
		}
  	]
}